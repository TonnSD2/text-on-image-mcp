# Copy to .env and fill in. NEVER commit .env.
# Public domain with an A/AAAA record pointing at this VPS.
TOI_DOMAIN=mcp.example.com

# token=workspace pairs. Generate tokens: openssl rand -hex 16
# Each token = one isolated user: its own scenes, own files under /data.
TOI_USERS=REPLACE_WITH_RANDOM_TOKEN_1=alice,REPLACE_WITH_RANDOM_TOKEN_2=bob

# Max scenes kept live in RAM (LRU; state itself persists on disk).
TOI_MAX_SCENES=16

# Image tag for the app (rollback = start previous tag).
TOI_TAG=dev-1